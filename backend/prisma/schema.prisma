generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  RECRUITER
  INTERVIEWER
  CANDIDATE
  PROCTOR
}

enum QuestionType {
  MCQ
  MSQ
  TRUE_FALSE
  CODING
  SQL
  DRAG_DROP
  FILL_BLANK
  VIDEO_RESPONSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  TIMED_OUT
  DISQUALIFIED
}

enum AnswerStatus {
  NOT_VISITED
  VISITED
  ANSWERED
  MARKED_FOR_REVIEW
  ANSWERED_AND_MARKED
}

enum ViolationType {
  TAB_SWITCH
  WINDOW_BLUR
  COPY_PASTE
  RIGHT_CLICK
  KEYBOARD_SHORTCUT
  MULTIPLE_FACES
  NO_FACE
  SUSPICIOUS_MOVEMENT
  SCREENSHOT_BLOCKED
  DEV_TOOLS_OPEN
  MULTIPLE_MONITORS
  VPN_DETECTED
  BROWSER_EXTENSION
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
  MEMORY_LIMIT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ─── MODELS ─────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              Role      @default(CANDIDATE)
  isEmailVerified   Boolean   @default(false)
  emailVerifyToken  String?
  resetPasswordToken String?
  resetPasswordExpiry DateTime?
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String?
  avatarUrl         String?
  phone             String?
  resumeUrl         String?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions          Session[]
  createdAssessments Assessment[]  @relation("CreatedAssessments")
  invitations       CandidateInvitation[]
  attempts          AssessmentAttempt[]
  violations        Violation[]
  proctoringLogs    ProctoringLog[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  apiWorkspaces     APIWorkspace[]
  apiTeamMembers    APITeamMember[]
  apiHistories      APIHistory[]
  apiLogs           APILog[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Permission {
  id       String @id @default(uuid())
  role     Role
  resource String
  action   String

  @@unique([role, resource, action])
  @@map("permissions")
}

model Assessment {
  id                String           @id @default(uuid())
  title             String
  description       String?
  instructions      String?
  status            AssessmentStatus @default(DRAFT)
  totalDuration     Int              // in minutes
  totalMarks        Float
  passingPercentage Float            @default(50)
  negativeMarking   Boolean          @default(false)
  negativeMarkValue Float            @default(0)
  randomizeQuestions Boolean         @default(false)
  randomizeOptions  Boolean          @default(false)
  showResults       Boolean          @default(true)
  allowResumeLater  Boolean          @default(false)
  autoSubmit        Boolean          @default(true)
  webcamRequired    Boolean          @default(false)
  fullscreenRequired Boolean        @default(true)
  maxAttempts       Int              @default(1)
  startDate         DateTime?
  endDate           DateTime?
  tags              String[]
  createdById       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User                  @relation("CreatedAssessments", fields: [createdById], references: [id])
  sections    Section[]
  invitations CandidateInvitation[]
  attempts    AssessmentAttempt[]

  @@map("assessments")
}

model Section {
  id              String @id @default(uuid())
  assessmentId    String
  title           String
  description     String?
  order           Int
  duration        Int?   // optional per-section timer in minutes
  totalMarks      Float  @default(0)
  shuffleQuestions Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions  Question[]

  @@map("sections")
}

model Question {
  id              String       @id @default(uuid())
  sectionId       String
  type            QuestionType
  difficulty      Difficulty   @default(MEDIUM)
  title           String
  body            String       // supports markdown/HTML
  explanation     String?
  marks           Float
  negativeMarks   Float        @default(0)
  timeLimitSeconds Int?        // per-question timer
  order           Int
  tags            String[]
  metadata        Json?        // flexible metadata for different question types

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section         Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options         Option[]
  codingConfig    CodingQuestionConfig?
  answers         Answer[]
  testCases       TestCase[]

  @@map("questions")
}

model Option {
  id         String  @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int
  imageUrl   String?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("options")
}

model CodingQuestionConfig {
  id              String   @id @default(uuid())
  questionId      String   @unique
  languages       String[] // java, python, javascript, cpp, go
  boilerplateCode Json?    // { language: code } mapping
  solutionCode    Json?    // reference solutions per language
  timeLimitMs     Int      @default(5000)
  memoryLimitMb   Int      @default(256)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("coding_question_configs")
}

model TestCase {
  id         String  @id @default(uuid())
  questionId String
  input      String
  expected   String
  isHidden   Boolean @default(false)
  order      Int
  weight     Float   @default(1)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model CandidateInvitation {
  id           String           @id @default(uuid())
  assessmentId String
  userId       String
  status       InvitationStatus @default(PENDING)
  token        String           @unique @default(uuid())
  expiresAt    DateTime
  sentAt       DateTime         @default(now())
  acceptedAt   DateTime?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, userId])
  @@map("candidate_invitations")
}

model AssessmentAttempt {
  id              String        @id @default(uuid())
  assessmentId    String
  userId          String
  status          AttemptStatus @default(NOT_STARTED)
  startedAt       DateTime?
  submittedAt     DateTime?
  timeSpentSeconds Int          @default(0)
  totalScore      Float         @default(0)
  maxScore        Float         @default(0)
  percentage      Float         @default(0)
  rank            Int?
  ipAddress       String?
  userAgent       String?
  browserFingerprint String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment       Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers          Answer[]
  violations       Violation[]
  proctoringLogs   ProctoringLog[]
  codeExecutions   CodeExecution[]

  @@unique([assessmentId, userId])
  @@map("assessment_attempts")
}

model Answer {
  id          String       @id @default(uuid())
  attemptId   String
  questionId  String
  status      AnswerStatus @default(NOT_VISITED)
  selectedOptionIds String[]
  textAnswer  String?
  codeAnswer  Json?        // { language, code }
  videoUrl    String?
  dragDropAnswer Json?     // ordering data
  score       Float        @default(0)
  isCorrect   Boolean?
  timeTakenSeconds Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempt  AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("answers")
}

model CodeExecution {
  id          String          @id @default(uuid())
  attemptId   String
  language    String
  sourceCode  String
  input       String?
  output      String?
  stderr      String?
  exitCode    Int?
  status      ExecutionStatus @default(QUEUED)
  executionTimeMs Int?
  memoryUsedKb    Int?
  testCasesPassed Int         @default(0)
  testCasesTotal  Int         @default(0)

  createdAt DateTime @default(now())

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("code_executions")
}

model Violation {
  id         String        @id @default(uuid())
  attemptId  String
  userId     String
  type       ViolationType
  details    String?
  screenshot String?       // S3 URL
  timestamp  DateTime      @default(now())

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("violations")
}

model ProctoringLog {
  id          String   @id @default(uuid())
  attemptId   String
  userId      String
  eventType   String
  eventData   Json?
  screenshotUrl String?
  webcamUrl   String?
  timestamp   DateTime @default(now())

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("proctoring_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  resource  String
  resourceId String?
  details   Json?
  ipAddress String?
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── API TESTING ENUMS ──────────────────────────────────────────

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum ApiAuthType {
  NONE
  BEARER_TOKEN
  BASIC_AUTH
  API_KEY
  OAUTH2
}

enum ApiBodyType {
  NONE
  JSON
  XML
  FORM_DATA
  MULTIPART
  RAW
  BINARY
  GRAPHQL
}

enum ApiRequestStatus {
  PENDING
  RUNNING
  SUCCESS
  ERROR
  TIMEOUT
  CANCELLED
}

enum ApiWorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ApiProtocol {
  REST
  GRAPHQL
  WEBSOCKET
  GRPC
}

// ─── API TESTING MODELS ─────────────────────────────────────────

model APIWorkspace {
  id            String   @id @default(uuid())
  name          String
  description   String?
  ownerId       String
  isPersonal    Boolean  @default(false)
  settings      Json?
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collections   APICollection[]
  environments  APIEnvironment[]
  teamMembers   APITeamMember[]
  mockServers   APIMockServer[]
  variables     APIVariable[]

  @@map("api_workspaces")
}

model APICollection {
  id            String   @id @default(uuid())
  workspaceId   String
  parentId      String?
  name          String
  description   String?
  order         Int      @default(0)
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     APIWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent        APICollection?   @relation("CollectionTree", fields: [parentId], references: [id])
  children      APICollection[]  @relation("CollectionTree")
  requests      APIRequest[]

  @@map("api_collections")
}

model APIRequest {
  id              String          @id @default(uuid())
  collectionId    String
  name            String
  description     String?
  method          HttpMethod      @default(GET)
  url             String
  protocol        ApiProtocol     @default(REST)
  headers         Json?
  queryParams     Json?
  pathParams      Json?
  cookies         Json?
  authType        ApiAuthType     @default(NONE)
  authConfig      Json?
  bodyType        ApiBodyType     @default(NONE)
  body            String?
  preRequestScript  String?
  testScript      String?
  timeoutMs       Int             @default(30000)
  followRedirects Boolean         @default(true)
  retryCount      Int             @default(0)
  retryDelayMs    Int             @default(1000)
  order           Int             @default(0)
  isDeleted       Boolean         @default(false)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  collection      APICollection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  responses       APIResponse[]
  histories       APIHistory[]
  testCases       APITestCase[]
  assertions      APIAssertion[]

  @@map("api_requests")
}

model APIEnvironment {
  id            String   @id @default(uuid())
  workspaceId   String
  name          String
  variables     Json     @default("[]")
  isActive      Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     APIWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("api_environments")
}

model APIHistory {
  id              String          @id @default(uuid())
  requestId       String?
  userId          String
  method          HttpMethod
  url             String
  requestHeaders  Json?
  requestBody     String?
  statusCode      Int?
  responseHeaders Json?
  responseBody    String?
  responseTimeMs  Int?
  responseSizeBytes Int?
  error           String?
  status          ApiRequestStatus @default(PENDING)
  createdAt       DateTime        @default(now())

  request         APIRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_histories")
}

model APIResponse {
  id              String   @id @default(uuid())
  requestId       String
  name            String
  statusCode      Int
  headers         Json?
  body            String?
  responseTimeMs  Int?
  createdAt       DateTime @default(now())

  request         APIRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("api_responses")
}

model APITestCase {
  id            String   @id @default(uuid())
  requestId     String
  name          String
  script        String
  isActive      Boolean  @default(true)
  lastResult    Json?
  lastRunAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  request       APIRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("api_test_cases_api")
}

model APIMockServer {
  id            String   @id @default(uuid())
  workspaceId   String
  name          String
  description   String?
  port          Int?
  isActive      Boolean  @default(false)
  routes        Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     APIWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("api_mock_servers")
}

model APIAssertion {
  id            String   @id @default(uuid())
  requestId     String
  name          String
  property      String
  comparison    String
  expectedValue String
  isActive      Boolean  @default(true)
  lastResult    Boolean?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  request       APIRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("api_assertions")
}

model APIVariable {
  id            String   @id @default(uuid())
  workspaceId   String
  key           String
  value         String
  isSecret      Boolean  @default(false)
  scope         String   @default("workspace")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     APIWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key, scope])
  @@map("api_variables")
}

model APITeamMember {
  id            String           @id @default(uuid())
  workspaceId   String
  userId        String
  role          ApiWorkspaceRole @default(VIEWER)
  joinedAt      DateTime         @default(now())

  workspace     APIWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("api_team_members")
}

model APILog {
  id            String   @id @default(uuid())
  userId        String
  action        String
  resource      String
  resourceId    String?
  details       Json?
  ipAddress     String?
  timestamp     DateTime @default(now())

  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_logs")
}
